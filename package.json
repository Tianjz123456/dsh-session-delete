{
  "name": "@local/dsh-session-delete",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "在会话菜单中新增“删除会话”：完整删除会话日志、投影缓存并从工作区中移除引用",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
